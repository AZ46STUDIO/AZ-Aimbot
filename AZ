local function SetSky(skyName)
    local preset = SkyPresets[skyName]
    if not preset then return end
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("Sky") then v:Destroy() end
    end
    local sky = Instance.new("Sky")
    sky.Name = skyName .. "Sky"
    for prop, value in pairs(preset) do
        sky[prop] = value
    end
    sky.Parent = Lighting
    CurrentSkyType = skyName
end

local function ResetSky()
    SetSky("Default")
end

-- =============================================
-- TARGET-VALIDIERUNG (zentral)
-- =============================================

local function IsTargetValid(player)
    if not player then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local part = char:FindFirstChild(TargetPart)
    if not part then return false end
    if not IsVisible(part) then return false end
    if not IsEnemy(player) then return false end

    if LockDistance > 0 then
        local distance = (part.Position - Camera.CFrame.Position).Magnitude
        if distance > LockDistance then return false end
    end

    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return false end
    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
    if dist > FOV then return false end
    return true
end

local function GetTargets()
    local Targets = {}
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and not table.find(excludedTargets, Player) then
            if IsTargetValid(Player) then
                local part = Player.Character[TargetPart]
                local pos = Camera:WorldToViewportPoint(part.Position)
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                local playerDist = (part.Position - Camera.CFrame.Position).Magnitude
                table.insert(Targets, { Part = part, Distance = dist, Player = Player, PlayerDist = playerDist })
            end
        end
    end
    if NearLock then
        table.sort(Targets, function(a, b) return a.PlayerDist < b.PlayerDist end)
    else
        table.sort(Targets, function(a, b) return a.Distance < b.Distance end)
    end
    return Targets
end

