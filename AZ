function UpdateAllRings()
    for player, ring in pairs(TeamRings) do
        if ring then ring:Destroy() end
    end
    TeamRings = {}
    if not _G.TeamCheckEnabled then return end
    if not _G.ShowCircle then return end
    for _, player in ipairs(_G.TeamList) do
        if typeof(player) == "Instance" and player:IsA("Player") and player ~= LocalPlayer then
            local Character = workspace:FindFirstChild(player.Name)
            if Character then
                local RootPart = Character:FindFirstChild("HumanoidRootPart")
                if RootPart then
                    local Ring = Instance.new("Part")
                    Ring.Name = "TeamRing_" .. player.Name
                    Ring.Anchored = true
                    Ring.CanCollide = false
                    Ring.CanTouch = false
                    Ring.CanQuery = false
                    Ring.Material = Enum.Material.Neon
                    Ring.Color = _G.TeamColor
                    Ring.Transparency = 0.35
                    Ring.Shape = Enum.PartType.Cylinder
                    Ring.Size = Vector3.new(0.2, _G.TeamRadius * 2, _G.TeamRadius * 2)
                    Ring.CFrame = CFrame.new(RootPart.Position.X, RootPart.Position.Y - 1.5, RootPart.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
                    Ring.Parent = workspace
                    TeamRings[player] = Ring
                end
            end
        end
    end
end

