    Multi = true,
    Searchable = true,
    Callback = function(Value)
        local newSelection = {}
        for key, _ in pairs(Value) do
            newSelection[key] = true
        end

        for i = #_G.TeamList, 1, -1 do
            local player = _G.TeamList[i]
            if player ~= LocalPlayer then
                local key = player.Name .. "/" .. (player.DisplayName or player.Name)
                if not newSelection[key] then
                    table.remove(_G.TeamList, i)
                end
            end
        end

        for key, _ in pairs(newSelection) do
            local username = key:match("^(.-)/")
            if username then
                local player = Players:FindFirstChild(username)
                if player and player ~= LocalPlayer then
                    local already = false
                    for _, tp in ipairs(_G.TeamList) do
                        if tp == player then already = true break end
                    end
                    if not already then
                        table.insert(_G.TeamList, player)
                    end
                end
            end
        end

        UpdateAllRings()
    end
})

