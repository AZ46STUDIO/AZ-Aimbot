local function SkipCurrentTarget()
    if InstantAimlock or LegitAimlock then
        if currentTarget then
            if not table.find(excludedTargets, currentTarget) then
                table.insert(excludedTargets, currentTarget)
            end
            currentTarget = nil
            showLastPos = false
            if targetCircle then targetCircle.Transparency = 1 end
            Library:Notify({
                Title = "Target Skip",
                Description = "Current target skipped.",
                Time = 1
            })
        else
            Library:Notify({
                Title = "Target Skip",
                Description = "No active target to skip.",
                Time = 1
            })
        end
    else
        Library:Notify({
            Title = "Target Skip",
            Description = "Aimlock is not active.",
            Time = 1
        })
    end
end

-- =============================================
-- AIM (RAW System + Target-Halte-Logik)
-- =============================================

local function AimAtTargets(Targets)
        if currentTarget then
        if IsTargetValid(currentTarget) then
            local part = currentTarget.Character[TargetPart]
            local targetPos = part.Position

            if LegitAimlock then
                if not legitOffsets[currentTarget] then
                    local offsetX = (math.random() * 3 - 1.5)
                    local offsetY = (math.random() * 3 - 1.5)
                    legitOffsets[currentTarget] = Vector3.new(offsetX, offsetY, 0)
                end
                local offset = legitOffsets[currentTarget]
                local worldOffset = part.CFrame:VectorToWorldSpace(offset)
                targetPos = targetPos + worldOffset
            end

            if targetCircle then
                targetCircle.Transparency = 0.4
                targetCircle.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, 0, math.rad(90))
            end
            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPos)

            if InstantAimlock then
                Camera.CFrame = targetCF
            elseif LegitAimlock then
                if AimSpeed > 0 then
                    local relative = currentCF:ToObjectSpace(targetCF)
                    local angles = Vector3.new(
                        math.atan2(-relative.LookVector.Y, relative.LookVector.Z),
                        math.atan2(relative.LookVector.X, relative.LookVector.Z),
                        0
                    )
                    local maxAngle = math.rad(AimSpeed * 0.1)
                    local clampedAngles = Vector3.new(
                        math.clamp(angles.X, -maxAngle, maxAngle),
                        math.clamp(angles.Y, -maxAngle, maxAngle),
                        0
                    )
                    Camera.CFrame = currentCF * CFrame.fromEulerAnglesXYZ(clampedAngles.X, clampedAngles.Y, 0)
                else
                    Camera.CFrame = targetCF
                end
            end
            showLastPos = false
            return
        else
            currentTarget = nil
            legitOffsets[currentTarget] = nil
            if targetCircle then targetCircle.Transparency = 1 end
            for i = #excludedTargets, 1, -1 do
                if not IsTargetValid(excludedTargets[i]) then
                    table.remove(excludedTargets, i)
                end
            end
        end
    end

    if #Targets > 0 then
        local targetData = Targets[1]
        if targetData and targetData.Player then
            currentTarget = targetData.Player
            if LegitAimlock then
                legitOffsets[currentTarget] = nil
            end
            local targetPos = targetData.Part.Position
            if targetCircle then
                targetCircle.Transparency = 0.4
                targetCircle.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, 0, math.rad(90))
            end
            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPos)
            if InstantAimlock then
                Camera.CFrame = targetCF
            elseif LegitAimlock then
                if AimSpeed > 0 then
                    local relative = currentCF:ToObjectSpace(targetCF)
                    local angles = Vector3.new(
                        math.atan2(-relative.LookVector.Y, relative.LookVector.Z),
                        math.atan2(relative.LookVector.X, relative.LookVector.Z),
                        0
                    )
                    local maxAngle = math.rad(AimSpeed * 0.1)
                    local clampedAngles = Vector3.new(
                        math.clamp(angles.X, -maxAngle, maxAngle),
                        math.clamp(angles.Y, -maxAngle, maxAngle),
                        0
                    )
                    Camera.CFrame = currentCF * CFrame.fromEulerAnglesXYZ(clampedAngles.X, clampedAngles.Y, 0)
                else
                    Camera.CFrame = targetCF
                end
            end
            showLastPos = false
        end
    else
        if targetCircle then targetCircle.Transparency = 1 end
        currentTarget = nil
        showLastPos = false
    end
end

