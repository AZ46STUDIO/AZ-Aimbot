-- =============================================
-- ESP CLEANUP
-- =============================================

local function CleanupESP()
    for _, box in pairs(ESPBoxes) do box:Remove() end
    for _, name in pairs(ESPNames) do name:Remove() end
    for _, health in pairs(ESPHealth) do health:Remove() end
    for _, dist in pairs(ESPDistances) do dist:Remove() end
    for _, bar in pairs(ESPHealthBars) do bar:Remove() end
    for _, glow in pairs(ESPGlow) do glow:Remove() end
    for _, tracer in pairs(Tracers) do tracer:Remove() end
    for _, cham in pairs(Chams) do cham:Destroy() end
    ESPBoxes = {}
    ESPNames = {}
    ESPHealth = {}
    ESPDistances = {}
    ESPHealthBars = {}
    ESPGlow = {}
    Tracers = {}
    Chams = {}
end

-- =============================================
-- ESP UPDATE (futuristisches Design)
-- =============================================

local function UpdateESP()
    if not ESPEnabled and not TracersEnabled and not ChamsEnabled then
        for _, box in pairs(ESPBoxes) do box.Visible = false end
        for _, name in pairs(ESPNames) do name.Visible = false end
        for _, health in pairs(ESPHealth) do health.Visible = false end
        for _, dist in pairs(ESPDistances) do dist.Visible = false end
        for _, bar in pairs(ESPHealthBars) do bar.Visible = false end
        for _, glow in pairs(ESPGlow) do glow.Visible = false end
        for _, tracer in pairs(Tracers) do tracer.Visible = false end
        for _, cham in pairs(Chams) do cham.Enabled = false end
        return
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
            and player.Character
            and player.Character:FindFirstChild("HumanoidRootPart")
            and player.Character:FindFirstChild("Humanoid")
            and player.Character.Humanoid.Health > 0
            and IsEnemy(player) then

            local root = player.Character.HumanoidRootPart
            local humanoid = player.Character.Humanoid
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)

            if onScreen then
                local size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                local boxPos = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)

                -- Glow-Effekt
                if ESPEnabled and BoxESPEnabled then
                    local glow = ESPGlow[player]
                    if not glow then
                        glow = Drawing.new("Square")
                        glow.Visible = false
                        glow.Color = ESPColor
                        glow.Thickness = 4
                        glow.Filled = false
                        glow.Transparency = 0.6
                        ESPGlow[player] = glow
                    end
                    glow.Size = size + Vector2.new(8, 8)
                    glow.Position = boxPos - Vector2.new(4, 4)
                    glow.Color = ESPColor
                    glow.Visible = true
                end

                -- Box (dünner Neon-Rahmen)
                if ESPEnabled and BoxESPEnabled then
                    local box = ESPBoxes[player]
                    if not box then
                        box = Drawing.new("Square")
                        box.Visible = false
                        box.Color = ESPColor
                        box.Thickness = 1.5
                        box.Filled = false
                        box.Transparency = 1
                        ESPBoxes[player] = box
                    end
                    box.Size = size
                    box.Position = boxPos
                    box.Color = ESPColor
                    box.Visible = true
                end

                -- Healthbar
                if ESPEnabled and HealthESPEnabled then
                    local bar = ESPHealthBars[player]
                    if not bar then
                        bar = Drawing.new("Square")
                        bar.Visible = false
                        bar.Thickness = 0
                        bar.Filled = true
                        bar.Transparency = 0.85
                        ESPHealthBars[player] = bar
                    end
                    local hp = humanoid.Health / humanoid.MaxHealth
                    bar.Size = Vector2.new(size.X * hp, 3)
                    bar.Position = Vector2.new(boxPos.X, boxPos.Y + size.Y + 2)
                    bar.Color = Color3.new(1 - hp, hp, 0)
                    bar.Visible = true
                end

                -- Name
                if ESPEnabled and NameESPEnabled then
                    local name = ESPNames[player]
                    if not name then
                        name = Drawing.new("Text")
                        name.Visible = false
                        name.Color = Color3.new(1, 1, 1)
                        name.Size = 14
                        name.Center = true
                        name.Outline = true
                        name.OutlineColor = Color3.new(0, 0, 0)
                        name.Text = player.Name
                        ESPNames[player] = name
                    end
                    name.Position = Vector2.new(pos.X, boxPos.Y - 16)
                    name.Text = player.Name
                    name.Visible = true
                end

                -- Distanz
                if ESPEnabled then
                    local dist = ESPDistances[player]
                    if not dist then
                        dist = Drawing.new("Text")
                        dist.Visible = false
                        dist.Color = Color3.new(1, 1, 1)
                        dist.Size = 11
                        dist.Center = true
                        dist.Outline = true
                        dist.OutlineColor = Color3.new(0, 0, 0)
                        ESPDistances[player] = dist
                    end
                    local distance = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                    dist.Text = distance .. "m"
                    dist.Position = Vector2.new(pos.X, boxPos.Y + size.Y + 18)
                    dist.Visible = true
                end

                -- Tracers
                if TracersEnabled then
                    local tracer = Tracers[player]
                    if not tracer then
                        tracer = Drawing.new("Line")
                        tracer.Visible = false
                        tracer.Color = ESPColor
                        tracer.Thickness = 1.5
                        Tracers[player] = tracer
                    end
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracer.To = Vector2.new(pos.X, pos.Y)
                    tracer.Color = ESPColor
                    tracer.Visible = true
                end

                -- Chams
                if ChamsEnabled then
                    local cham = Chams[player]
                    if not cham then
                        cham = Instance.new("Highlight")
                        cham.Name = "ESPChams"
                        cham.FillColor = ESPColor
                        cham.FillTransparency = 0.4
                        cham.OutlineColor = Color3.new(1, 1, 1)
                        cham.OutlineTransparency = 0.2
                        cham.Parent = player.Character
                        Chams[player] = cham
                    end
                    cham.Enabled = true
                    cham.FillColor = ESPColor
                end
            else
                if ESPBoxes[player] then ESPBoxes[player].Visible = false end
                if ESPNames[player] then ESPNames[player].Visible = false end
                if ESPHealth[player] then ESPHealth[player].Visible = false end
                if ESPDistances[player] then ESPDistances[player].Visible = false end
                if ESPHealthBars[player] then ESPHealthBars[player].Visible = false end
                if ESPGlow[player] then ESPGlow[player].Visible = false end
                if Tracers[player] then Tracers[player].Visible = false end
                if Chams[player] then Chams[player].Enabled = false end
            end
        else
            if ESPBoxes[player] then ESPBoxes[player].Visible = false end
            if ESPNames[player] then ESPNames[player].Visible = false end
            if ESPHealth[player] then ESPHealth[player].Visible = false end
            if ESPDistances[player] then ESPDistances[player].Visible = false end
            if ESPHealthBars[player] then ESPHealthBars[player].Visible = false end
            if ESPGlow[player] then ESPGlow[player].Visible = false end
            if Tracers[player] then Tracers[player].Visible = false end
            if Chams[player] then
                Chams[player]:Destroy()
                Chams[player] = nil
            end
        end
    end
end

