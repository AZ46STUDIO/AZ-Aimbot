function AddPlayersInCircleToTeam()
    local MyCharacter = LocalPlayer.Character
    if not MyCharacter then return end
    local MyRootPart = MyCharacter:FindFirstChild("HumanoidRootPart")
    if not MyRootPart then return end

    local function IsInCircle(pos)
        local distance = (pos - MyRootPart.Position).Magnitude
        return distance <= CircleRadius
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local Character = workspace:FindFirstChild(Player.Name)
            if Character then
                local OtherRootPart = Character:FindFirstChild("HumanoidRootPart")
                if OtherRootPart then
                    local pos = OtherRootPart.Position
                    if IsInCircle(pos) then
                        local AlreadyInTeam = false
                        for _, TeamPlayer in ipairs(_G.TeamList) do
                            if TeamPlayer == Player then AlreadyInTeam = true break end
                        end
                        if not AlreadyInTeam then
                            table.insert(_G.TeamList, Player)
                        end
                    end
                end
            end
        end
    end
    UpdateAllRings()
    RefreshWhitelistDropdown()
    Library:Notify({
        Title = "Team",
        Description = "Players in the circle were added to the team.",
        Time = 3
    })
end

